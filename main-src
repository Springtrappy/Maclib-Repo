			if hDrag then
				local pos = math.clamp((inp.Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 1)
				hVal = pos
				HKnob.Position = UDim2.new(pos, pos == 1 and -4 or 0, 0, 0)
				updateColor()
			elseif sDrag then
				local pos = math.clamp((inp.Position.X - SatBar.AbsolutePosition.X) / SatBar.AbsoluteSize.X, 0, 1)
				sVal = pos
				SKnob.Position = UDim2.new(pos, pos == 1 and -4 or 0, 0, 0)
				updateColor()
			end
		end
	end)
