			local d = inp.Position - drgSt
			TS:Create(LMG2L["MainFrame_2"], TweenInfo.new(0.05, Enum.EasingStyle.Linear), {Position = UDim2.new(drgPos.X.Scale, drgPos.X.Offset + d.X, drgPos.Y.Scale, drgPos.Y.Offset + d.Y)}):Play()
		elseif rsz then
			local d = inp.Position - rszSt
			local nwX = math.max(250, rszSz.X.Offset + d.X)
			local nwY = math.max(150, rszSz.Y.Offset + d.Y)
			TS:Create(LMG2L["MainFrame_2"], TweenInfo.new(0, Enum.EasingStyle.Linear), {Size = UDim2.new(0, nwX, 0, nwY)}):Play()
		end
	end
end)

local function toggleUI()
	if btnMoved then return end
	isOpen = not isOpen
	if isOpen then
		LMG2L["MainFrame_2"].Visible = true
		TS:Create(LMG2L["MainFrame_2"], TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = defaultSize}):Play()
	else
		local tw = TS:Create(LMG2L["MainFrame_2"], TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
		tw:Play()
		tw.Completed:Connect(function()
			if not isOpen then
				LMG2L["MainFrame_2"].Visible = false
			end
		end)
	end
end

