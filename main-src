function LMG2L:CreateSlider(name, min, max, default, callback)
	local SFrame = Instance.new("Frame", LMG2L["ElementsList_15"])
	SFrame.Size = UDim2.new(1, -10, 0, 42)
	SFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	SFrame.BorderSizePixel = 0
	
	local SCorner = Instance.new("UICorner", SFrame)
	SCorner.CornerRadius = UDim.new(0, 6)
	
	local SText = Instance.new("TextLabel", SFrame)
	SText.Size = UDim2.new(1, -50, 0, 18)
	SText.Position = UDim2.new(0, 8, 0, 4)
	SText.BackgroundTransparency = 1
	SText.Text = name
	SText.TextColor3 = Color3.fromRGB(0, 0, 0)
	SText.TextXAlignment = Enum.TextXAlignment.Left
	SText.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	SText.TextSize = 14
	
	local VText = Instance.new("TextLabel", SFrame)
	VText.Size = UDim2.new(0, 40, 0, 18)
	VText.Position = UDim2.new(1, -48, 0, 4)
	VText.BackgroundTransparency = 1
	VText.Text = tostring(default or min)
	VText.TextColor3 = Color3.fromRGB(120, 120, 120)
	VText.TextXAlignment = Enum.TextXAlignment.Right
	VText.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	VText.TextSize = 13
	
	local Bar = Instance.new("Frame", SFrame)
	Bar.Size = UDim2.new(1, -16, 0, 6)
	Bar.Position = UDim2.new(0, 8, 1, -12)
	Bar.BackgroundColor3 = Color3.fromRGB(235, 235, 235)
	Bar.BorderSizePixel = 0
	
	local BarCorner = Instance.new("UICorner", Bar)
	BarCorner.CornerRadius = UDim.new(1, 0)
	
	local Fill = Instance.new("Frame", Bar)
	local initVal = math.clamp((default or min) - min, 0, max - min) / (max - min)
	Fill.Size = UDim2.new(initVal, 0, 1, 0)
	Fill.BackgroundColor3 = Color3.fromRGB(255, 186, 27)
	Fill.BorderSizePixel = 0
	
	local FillCorner = Instance.new("UICorner", Fill)
	FillCorner.CornerRadius = UDim.new(1, 0)
	
	local Grad = Instance.new("UIGradient", Fill)
	Grad.Rotation = 90
	Grad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 186, 27)), ColorSequenceKeypoint.new(1, Color3.fromRGB(213, 0, 17))}
	
	local Knob = Instance.new("Frame", Bar)
	Knob.Size = UDim2.new(0, 12, 0, 12)
	Knob.AnchorPoint = Vector2.new(0.5, 0.5)
	Knob.Position = UDim2.new(initVal, 0, 0.5, 0)
	Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Knob.BorderSizePixel = 0
	
	local KnobCorner = Instance.new("UICorner", Knob)
	KnobCorner.CornerRadius = UDim.new(1, 0)
	
	local KnobStroke = Instance.new("UIStroke", Knob)
	KnobStroke.Thickness = 1
	KnobStroke.Color = Color3.fromRGB(200, 200, 200)
	
	local sliding = false
	local function update(inp)
		local pos = math.clamp((inp.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + (max - min) * pos)
		Fill.Size = UDim2.new(pos, 0, 1, 0)
		Knob.Position = UDim2.new(pos, 0, 0.5, 0)
		VText.Text = tostring(val)
		if callback then callback(val) end
	end
	
	Bar.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			update(inp)
		end
	end)
	
	UIS.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
	
	UIS.InputChanged:Connect(function(inp)
		if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			update(inp)
		end
	end)
end

