	local function updateColor()
		local baseColor = Color3.fromHSV(hVal, 1, 1)
		SBGrad.Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, baseColor)
